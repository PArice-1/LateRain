---
import { getCollection } from 'astro:content';
import ArchiveHero from '../../components/ArchiveHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingMinutes, sortByDateDesc } from '../../lib/content';
import { withBase } from '../../lib/urls';

const posts = sortByDateDesc((await getCollection('posts')).filter((post) => !post.data.draft));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
---
<BaseLayout title="文章 — LateRain" description="技术文章、项目复盘与思考。">
  <ArchiveHero title="文章" description="把项目中的问题、判断和过程，整理成可回看的文字。">
    <div class="filters" aria-label="按标签筛选文章">
      <button type="button" class="filter" data-tag="全部" aria-pressed="true">全部</button>
      {tags.map((tag) => <button type="button" class="filter" data-tag={tag} aria-pressed="false">{tag}</button>)}
    </div>
  </ArchiveHero>

  <section class="shell post-index-list" id="post-list" aria-live="polite">
    {posts.map((post) => (
      <article class="post-index-row" data-tags={post.data.tags.join('|')} data-reveal>
        <div class="post-index-meta">
          <div>{formatDate(post.data.publishDate)}</div>
          <div>{readingMinutes(post.body ?? '')} 分钟</div>
        </div>
        <div class="post-index-main">
          <h2><a href={withBase(`posts/${post.id}`)}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        </div>
        <a class="post-index-arrow" href={withBase(`posts/${post.id}`)} aria-label={`阅读 ${post.data.title}`}>→</a>
      </article>
    ))}
    <p id="empty-posts" class="empty" hidden>该标签下暂时还没有文章。</p>
  </section>
</BaseLayout>

<script>
  import { resolvePostTag } from '../../lib/content';
  import { getFilterMotionTiming } from '../../lib/ui';

  function setupPostFilters() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-tags]'));
    const list = document.querySelector<HTMLElement>('#post-list');
    const empty = document.querySelector<HTMLElement>('#empty-posts');
    if (!buttons.length || !list || list.dataset.ready === 'true') return;

    const tags = buttons.map((button) => button.dataset.tag).filter((tag): tag is string => Boolean(tag));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const motion = getFilterMotionTiming(reducedMotion);
    let transitionSequence = 0;

    const applyTag = async (tag: string, updateUrl: boolean, animate = true) => {
      const sequence = ++transitionSequence;
      list.getAnimations().forEach((animation) => animation.cancel());
      list.classList.add('is-filtering');
      const matches = rows.filter((row) => tag === '全部' || row.dataset.tags?.split('|').includes(tag));
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.tag === tag)));

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (tag === '全部') url.searchParams.delete('tag');
        else url.searchParams.set('tag', tag);
        window.history.replaceState(null, '', url);
      }

      if (animate && motion.exit > 0) {
        try {
          await list.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: .28, transform: `translateY(${motion.distance}px)` }],
            { duration: motion.exit, easing: 'ease-out', fill: 'forwards' },
          ).finished;
        } catch {
          // A newer filter selection cancelled this transition.
        }
      }
      if (sequence !== transitionSequence) return;

      rows.forEach((row) => row.hidden = !matches.includes(row));
      if (empty) empty.hidden = matches.length !== 0;
      list.getAnimations().forEach((animation) => animation.cancel());

      if (animate && motion.enter > 0) {
        try {
          await list.animate(
            [{ opacity: 0, transform: `translateY(${motion.distance}px)` }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: motion.enter, easing: 'cubic-bezier(.22,1,.36,1)' },
          ).finished;
        } catch {
          // A newer filter selection cancelled this transition.
        }
      }
      if (sequence === transitionSequence) list.classList.remove('is-filtering');
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      void applyTag(resolvePostTag(button.dataset.tag ?? null, tags), true);
    }));
    list.dataset.ready = 'true';

    const requestedTag = new URLSearchParams(window.location.search).get('tag');
    void applyTag(resolvePostTag(requestedTag, tags), false, false);
  }

  document.addEventListener('astro:page-load', setupPostFilters);
  setupPostFilters();
</script>
