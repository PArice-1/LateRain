---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={`${project.data.title} — LateRain`} description={project.data.summary}>
  <section class="shell detail-hero" data-reveal>
    <span class="status">{project.data.status}</span>
    <h1>{project.data.title}</h1>
    <p>{project.data.summary}</p>
    <div class="stack-list">{project.data.stack.map((item) => <span class="tag">{item}</span>)}</div>
    <div class="actions detail-actions">
      <a class="button" href={project.data.githubUrl} target="_blank" rel="noreferrer">查看 GitHub <span class="arrow">↗</span></a>
      {project.data.demoUrl && <a class="button button--ghost" href={project.data.demoUrl} target="_blank" rel="noreferrer">在线体验 <span class="arrow">↗</span></a>}
    </div>
  </section>
  <article class="detail-body prose" data-reveal>
    <p class="meta">发布于 {formatDate(project.data.publishDate)}</p>
    <Content />
  </article>
</BaseLayout>
