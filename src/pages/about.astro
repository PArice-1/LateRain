---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="关于 — LateRain" description="关于这个个人项目博客。">
  <section class="about" data-reveal>
    <h1>关于这个空间</h1>
    <p>这里是一个围绕作品与文字展开的个人站点。它不追求填满页面，只把值得保留的项目和想法整理清楚。</p>
    <p class="about-action"><a class="button" href={site.githubUrl} target="_blank" rel="noreferrer">访问 GitHub <span class="arrow">↗</span></a></p>
  </section>
</BaseLayout>
