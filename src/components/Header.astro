---
import { navigation, site } from '../config/site';
import { isNavigationItemActive } from '../lib/navigation';
import { withBase } from '../lib/urls';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase()} aria-label={`${site.name} 首页`}>{site.name}</a>
    <nav class="nav" aria-label="主导航">
      {navigation.map((item) => <a href={withBase(item.href)} aria-current={isNavigationItemActive(Astro.url.pathname, item.href, import.meta.env.BASE_URL) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-button" id="theme-toggle" aria-label="切换深色或浅色主题" title="切换主题">
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 019.8 3.5a8.5 8.5 0 1010.7 10.7Z"/></svg>
      </button>
      <a class="github-mark" href={site.githubUrl} target="_blank" rel="noreferrer" aria-label="打开 GitHub">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05A9.28 9.28 0 0112 6.83c.85 0 1.71.12 2.51.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.93.68 1.88 0 1.36-.01 2.45-.01 2.79 0 .27.18.6.69.5A10.24 10.24 0 0022 12.23C22 6.58 17.52 2 12 2Z"/></svg>
      </a>
    </div>
  </div>
</header>
<script>
  import { nextTheme, resolveInitialTheme, type Theme } from '../lib/ui';

  const syncThemeControl = () => {
    try {
      document.documentElement.dataset.theme = resolveInitialTheme(localStorage.getItem('theme'));
    } catch {
      document.documentElement.dataset.theme = 'dark';
    }

    const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
    if (!button || button.dataset.ready === 'true') return;

    const updateLabel = () => {
      const currentTheme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      button.setAttribute('aria-label', currentTheme === 'dark' ? '切换到浅色主题' : '切换到深色主题');
      button.title = currentTheme === 'dark' ? '切换到浅色主题' : '切换到深色主题';
      document.querySelector<HTMLMetaElement>('#theme-color')?.setAttribute('content', currentTheme === 'dark' ? '#050d16' : '#f4f6f7');
    };

    button.dataset.ready = 'true';
    button.addEventListener('click', () => {
      const currentTheme: Theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const theme = nextTheme(currentTheme);
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('theme', theme);
      updateLabel();
    });
    updateLabel();
  };

  document.addEventListener('astro:page-load', syncThemeControl);
  syncThemeControl();
</script>
